# Configuração local de manutenção do 2G Connector.
# Copie para .env e preencha. O .env é ignorado pelo git; este arquivo não.
#
# Nenhuma variável aqui guarda o CONTEÚDO de um segredo — só onde ele está.
# A chave privada de assinatura vive em dois lugares: no secret do GitHub e no
# arquivo local apontado abaixo (mais o backup offline do mantenedor).

# ── Assinatura do updater (ECDSA P-256) ──────────────────────────────────
UPDATE_SIGNING_KEY_PATH=
UPDATE_SIGNING_PUBLIC_KEY_PATH=
# Nome do secret do GitHub que o CI usa para assinar o update.json.
UPDATE_SIGNING_SECRET_NAME=UPDATE_SIGNING_KEY

# ── GitHub ───────────────────────────────────────────────────────────────
GITHUB_REPO=galenoferreira/gps_connector

# ── Site (download público) ──────────────────────────────────────────────
SITE_S3_BUCKET=2gpilot-com-site
SITE_S3_REGION=us-east-1
SITE_DOWNLOAD_PAGE_KEY=gps-connector.html

# ── Testes do updater ────────────────────────────────────────────────────
# Troca o feed para testar contra um pré-release. A assinatura continua
# obrigatória, então isto não enfraquece a verificação. Deixe comentado no uso
# normal: definido, o app passa a buscar atualizações só nesse endereço.
# TWOG_UPDATE_FEED=https://github.com/galenoferreira/gps_connector/releases/download/v1.4.1-rc.1/update.json
