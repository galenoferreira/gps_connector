<Window x:Class="TwoG.GpsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:TwoG.GpsClient.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="2G GPS Cliente for MSFS"
        Width="470" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ícone de bandeja -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Assets/app.ico"
                        ToolTipText="2G GPS Cliente for MSFS"
                        TrayMouseDoubleClick="TrayOpen_Click">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir" Click="TrayOpen_Click" />
                    <Separator />
                    <MenuItem Header="Sair" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ══ Cabeçalho ══ -->
        <Grid Grid.Row="0" Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="11" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33D1C4" Offset="0" />
                        <GradientStop Color="#1B7F8E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="2G" FontSize="17" FontWeight="Bold" Foreground="#07272B"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="2G GPS Cliente" FontSize="19" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="for Microsoft Flight Simulator" FontSize="12"
                           Foreground="{StaticResource DimBrush}" Margin="1,1,0,0" />
            </StackPanel>
        </Grid>

        <!-- ══ Simulador ══ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SIMULADOR" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding SimStatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SimStatusText}" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SimDetail}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource DimBrush}" Margin="19,3,0,0" />
            </StackPanel>
        </Border>

        <!-- ══ Transmissão ══ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="TRANSMISSÃO XGPS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding PacketsText}" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding TxStatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TxStatusText}" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding TxDetail}" FontSize="11.5"
                           Foreground="{StaticResource DimBrush}" Margin="19,3,0,0" />
            </StackPanel>
        </Border>

        <!-- ══ Posição ══ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel Opacity="{Binding PositionOpacity}">
                <TextBlock Text="POSIÇÃO" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LATITUDE" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LatText}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="LONGITUDE" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LonText}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="ALTITUDE" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AltText}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="VEL. SOLO" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GsText}" Style="{StaticResource ValueText}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CURSO (TRK)" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding TrkText}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="PROA (HDG)" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HdgText}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="ARFAGEM" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PitchText}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="ROLAGEM" Style="{StaticResource ValueLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding RollText}" Style="{StaticResource ValueText}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ Configurações ══ -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Expander>
                <Expander.Header>
                    <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource SectionTitle}" />
                </Expander.Header>
                <StackPanel Margin="2,12,2,2">
                    <TextBlock Text="Nome do dispositivo (exibido no EFB)" Style="{StaticResource ValueLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DeviceNameInput, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Porta UDP" Style="{StaticResource ValueLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Posição (Hz)" Style="{StaticResource ValueLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding XgpsHzInput, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Atitude (Hz)" Style="{StaticResource ValueLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding XattHzInput, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="IPs adicionais — unicast, separados por vírgula (opcional)"
                               Style="{StaticResource ValueLabel}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding UnicastInput, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Iniciar junto com o MSFS (recomendado)"
                              IsChecked="{Binding StartWithSimInput}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Iniciar minimizado" IsChecked="{Binding StartMinimizedInput}" />
                        <CheckBox Content="Fechar para a bandeja" IsChecked="{Binding CloseToTrayInput}" Margin="18,0,0,0" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="{Binding SettingsFeedback}" Foreground="{Binding SettingsFeedbackBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <Button Content="Aplicar" Command="{Binding ApplySettingsCommand}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- ══ Rodapé ══ -->
        <TextBlock Grid.Row="5" Text="{Binding VersionText, Mode=OneTime}" FontSize="10.5"
                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
    </Grid>
</Window>
