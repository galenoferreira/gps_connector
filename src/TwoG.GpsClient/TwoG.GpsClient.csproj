<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TwoG.GpsClient</RootNamespace>
    <AssemblyName>2G-GPS-Cliente</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>1.0.0</Version>
    <Product>2G GPS Cliente for MSFS</Product>
    <Company>2G</Company>
    <Copyright>© 2026 2G. Todos os direitos reservados.</Copyright>
    <Description>Conector GPS para Microsoft Flight Simulator — transmite posição via XGPS para EFBs (2G Pilot, ForeFlight e outros).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <!--
    DLLs oficiais do SimConnect (MSFS SDK 0.24.3.0), vendorizadas em /libs — não há
    pacote NuGet oficial. O wrapper gerenciado é mixed-mode x64 e funciona em .NET
    moderno; um cliente da era 2020 conecta ao MSFS 2020 E 2024 (confirmado pela
    Asobo). Mesma arquitetura do fs2ff. A SimConnect.dll nativa precisa estar ao
    lado do exe: o Reference copia a gerenciada, o None copia a nativa.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>..\..\libs\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <None Include="..\..\libs\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwoG.GpsClient.Core\TwoG.GpsClient.Core.csproj" />
  </ItemGroup>

</Project>
