<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TwoG.Connector</RootNamespace>
    <AssemblyName>2G-Connector</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Distribuição: um único .exe autocontido, sem instalador nem runtime .NET.
         O RID é fixo (o app só roda em Windows x64), então `dotnet publish` não
         precisa de -r e o build local não tenta inferir o RID do host. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Símbolos dentro do assembly: evita .pdb solto ao lado do exe. -->
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.0</Version>
    <Product>2G Connector</Product>
    <Company>2G</Company>
    <Copyright>© 2026 2G. Todos os direitos reservados.</Copyright>
    <Description>Ponte entre simuladores de voo (MSFS, Prepar3D, X-Plane) e EFBs — transmite posição via XGPS para 2G Pilot, ForeFlight e outros.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <!--
    Canal do updater, injetado pelo CI só em builds de tag (-p:UpdateChannel=stable).
    Sem ele o updater fica desligado: um build local ou de branch não pode se
    "atualizar" para o último release na primeira oportunidade.
  -->
  <ItemGroup Condition="'$(UpdateChannel)' != ''">
    <AssemblyMetadata Include="UpdateChannel" Value="$(UpdateChannel)" />
  </ItemGroup>

  <!--
    DLLs oficiais do SimConnect (MSFS SDK 0.24.3.0), vendorizadas em /libs — não há
    pacote NuGet oficial. Um cliente da era 2020 conecta ao MSFS 2020 E 2024
    (confirmado pela Asobo). Mesma arquitetura do fs2ff.

    Elas NÃO são copiadas para a saída (Private=false) nem entram no bundle
    single-file: o wrapper gerenciado é mixed-mode (C++/CLI) e a doc da Microsoft
    diz que "managed C++ components aren't well suited for single file deployment"
    — não é carregável a partir da memória do bundle. Em vez disso, viajam como
    recursos embutidos e o SimConnectRuntime as extrai para o cache do usuário na
    primeira execução, carregando-as de arquivos reais em disco (cenário suportado).
  -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>..\..\libs\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="..\..\libs\Microsoft.FlightSimulator.SimConnect.dll"
                      LogicalName="TwoG.Connector.Native.Microsoft.FlightSimulator.SimConnect.dll" />
    <EmbeddedResource Include="..\..\libs\SimConnect.dll"
                      LogicalName="TwoG.Connector.Native.SimConnect.dll" />
  </ItemGroup>

  <!--
    Runtime do Visual C++ 2015-2022 x64, extraído do vc_redist.x64.exe oficial.
    A SimConnect.dll nativa importa MSVCP140/VCRUNTIME140/VCRUNTIME140_1; sem elas
    o LoadLibrary falha com erro 126 (ERROR_MOD_NOT_FOUND) em máquinas que nunca
    instalaram o redistributable (o MSFS o instala, mas não queremos depender disso).
    A Microsoft permite a distribuição "app-local" destas DLLs. São extraídas para
    a mesma pasta da SimConnect.dll e pré-carregadas antes dela.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\libs\vcruntime\MSVCP140.dll"
                      LogicalName="TwoG.Connector.Native.MSVCP140.dll" />
    <EmbeddedResource Include="..\..\libs\vcruntime\VCRUNTIME140.dll"
                      LogicalName="TwoG.Connector.Native.VCRUNTIME140.dll" />
    <EmbeddedResource Include="..\..\libs\vcruntime\VCRUNTIME140_1.dll"
                      LogicalName="TwoG.Connector.Native.VCRUNTIME140_1.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwoG.Connector.Core\TwoG.Connector.Core.csproj" />
  </ItemGroup>

</Project>
